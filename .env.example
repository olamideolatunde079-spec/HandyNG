# ============================================================
# HandyNG — Environment variable reference
# ============================================================
# This is a reference file. Do NOT put real values here.
#
# Setup:
#   1. For the FRONTEND: copy to frontend/.env.local and fill in values
#   2. For the BACKEND:  copy to backend/.env and fill in values
#
# Why separate files?
#   Next.js only reads .env.local from the frontend/ directory.
#   Express reads .env from the backend/ directory.
# ============================================================

# ─────────────────────────────────────────────────────────────
# frontend/.env.local  (Next.js reads this automatically)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# backend/.env  (loaded by dotenv in backend/src/config/env.ts)
# ─────────────────────────────────────────────────────────────

# Supabase — backend only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Direct postgres connection (for running migrations)
# Get from: Supabase Dashboard → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Server config
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
